node_modules/
.vercel/
.DS_Store
Thumbs.db
*.log

# Alat lokal, bukan bagian dari situs.
.freebuff/

# Sertifikat asli, resolusi penuh. Yang masuk repo hanya versi yang sudah
# dikompres + diberi watermark di `assets/certificates/`.
sertifikat/

# Berkas yang tidak dirujuk halaman mana pun. Semuanya tetap ada di disk,
# hanya tidak ikut ke repo.
#
# `--selector`           PNG 15 KB dari download nyasar, bukan file selector
# `background/`          clip sumber 440 KB, tidak dipakai hero
# `font/Pally-Bold.otf`  tidak dipakai; font situs ada di `assets/fonts/`
--selector
background/
font/Pally-Bold.otf

# `package.json` ikut dikeluarkan dari repo. Berkas ini hanya untuk
# `npm start` lokal, dan sudah dikecualikan di `.vercelignore` juga, jadi
# Vercel tidak pernah melihatnya. Tanpa itu Vercel mendeteksi proyek ini
# sebagai aplikasi Node dan build-nya gagal - tidak ada folder `api/`,
# tidak ada field `main`, tidak ada handler server.
package.json
